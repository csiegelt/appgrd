# Crea una clave de proyecto en https://platform.openai.com/api-keys
# Pega la clave SOLO en .env o en las variables secretas de tu hosting.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Uso local: abre http://127.0.0.1:8787
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=
APP_PASSWORD=

# Hosting con HTTPS: HOST=0.0.0.0, APP_ORIGIN=https://tu-dominio
# y APP_PASSWORD con al menos 16 caracteres. Deja que el hosting asigne PORT.
# APP_PASSWORD protege el tutor; es distinta de tu clave de OpenAI.

# Vercel: configura OPENAI_API_KEY, OPENAI_MODEL, APP_ORIGIN y APP_PASSWORD
# en Project > Settings > Environment Variables > Production y vuelve a desplegar.
# APP_ORIGIN=https://appgrd.vercel.app (o tu dominio exacto).
# No copies PORT ni HOST locales a Vercel. Las claves no se suben al repositorio.
